# {{$guid}} for a random ID 
# {{$timestamp}} for the current time.

@baseUrl = http://localhost:3001/auth
@authToken = your_token_here

### Register

POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "mridul_dev",
  "email": "mridul@example.com",
  "password": "SecurePassword123!",
  "country": "Bangladesh",
  "profilePicture": "https://example.com/profiles/mridul_dev.jpg"
}


### Resend Verification Link

POST {{baseUrl}}/resend-verification-link
Content-Type: application/json

{
  "email": "mridul@example.com"
}


### Verify Email

PUT {{baseUrl}}/verify-email
Content-Type: application/json

{
  "token": "2bac3665348e2abca1945c5bded91bb9288efdbc"
}

### Login

POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "mridul@example.com",
  "password": "SecurePassword123!"
}

### Forgot Password

PUT {{baseUrl}}/forgot-password
Content-Type: application/json

{
  "email": "mridul@example.com"
}
